{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.ts",
      "buildCommand": "npx prisma generate",
      "bindings": [
        {
          "type": "service",
          "service": "python",
          "format": "url",
          "env": "PYTHON_SERVICE_URL"
        }
      ]
    },
    "python": {
      "root": "python-services",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": { "service": "backend" } },
    { "source": "/uploads/:path*", "destination": { "service": "backend" } },
    { "source": "/api/docs/:path*", "destination": { "service": "backend" } },
    { "source": "/api/docs", "destination": { "service": "backend" } },
    { "source": "/api/docs.json", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
