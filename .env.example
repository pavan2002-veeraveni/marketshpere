# ==============================================================================
# MarketSphere Environment Configuration (.env.example)
# Copy to .env (and/or service-specific .env files) with synthetic local values.
# NEVER commit real secrets or production credentials.
# ==============================================================================

# Environment
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=marketsphere
POSTGRES_PASSWORD=replace_with_dev_postgres_password
POSTGRES_DB=marketsphere
DATABASE_URL=postgresql://marketsphere:replace_with_dev_postgres_password@localhost:5435/marketsphere?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Backend Express API
BACKEND_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_SECRET=replace_with_at_least_32_char_random_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_char_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=replace_with_shared_internal_service_token
RESERVATION_TTL_MINUTES=15
MAX_UPLOAD_SIZE_BYTES=5242880
UPLOAD_STORAGE_DIR=./uploads

# Sandbox Integration Adapters
PAYMENT_SANDBOX_MODE=sandbox
PAYMENT_WEBHOOK_SECRET=replace_with_sandbox_payment_webhook_secret
SHIPPING_SANDBOX_MODE=sandbox
SHIPPING_WEBHOOK_SECRET=replace_with_sandbox_shipping_webhook_secret
EMAIL_SANDBOX_MODE=sandbox
OBJECT_STORAGE_MODE=local_sandbox

# Python FastAPI Service
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_PORT=8000
PYTHON_TIMEOUT_MS=5000
DEFAULT_TAX_RATE=0.0825
DEFAULT_CURRENCY=USD

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=MarketSphere
NEXT_PUBLIC_SANDBOX_MODE=true
