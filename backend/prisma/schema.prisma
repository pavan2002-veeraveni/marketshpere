  @@map("outbox_events")
}

model SystemConfig {
  key             String   @id @db.VarChar(120)
  value           Json
  description     String?  @db.VarChar(255)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
