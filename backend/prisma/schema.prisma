model CommissionRule {
  id             String         @id @default(uuid()) @db.Uuid
  name           String         @db.VarChar(150)
  sellerId       String?        @map("seller_id") @db.Uuid
  categoryId     String?        @map("category_id") @db.Uuid
  commissionType CommissionType @default(PERCENTAGE) @map("commission_type")
  percentageRate Decimal        @default(0) @map("percentage_rate") @db.Decimal(7, 4)
  fixedAmount    Decimal        @default(0) @map("fixed_amount") @db.Decimal(14, 2)
  priority       Int            @default(100)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  seller   Seller?            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ledgers  CommissionLedger[]

  @@index([sellerId, categoryId, isActive])
  @@map("commission_rules")
}

model CommissionLedger {
  id                String                 @id @default(uuid()) @db.Uuid
  orderId           String                 @map("order_id") @db.Uuid
  orderItemId       String                 @unique @map("order_item_id") @db.Uuid
  sellerId          String                 @map("seller_id") @db.Uuid
  commissionRuleId  String?                @map("commission_rule_id") @db.Uuid
  grossAmount       Decimal                @map("gross_amount") @db.Decimal(14, 2)
  discountAllocated Decimal                @default(0) @map("discount_allocated") @db.Decimal(14, 2)
  commissionAmount  Decimal                @map("commission_amount") @db.Decimal(14, 2)
  netSellerAmount   Decimal                @map("net_seller_amount") @db.Decimal(14, 2)
  status            CommissionLedgerStatus @default(PENDING)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  commissionRule CommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  settlementItem SettlementItem?

  @@index([sellerId, status, createdAt])
  @@map("commission_ledger")
}

model Settlement {
  id               String           @id @default(uuid()) @db.Uuid
  settlementNumber String           @unique @map("settlement_number") @db.VarChar(50)
  sellerId         String           @map("seller_id") @db.Uuid
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  grossSales       Decimal          @map("gross_sales") @db.Decimal(14, 2)
  totalCommissions Decimal          @map("total_commissions") @db.Decimal(14, 2)
  totalRefunds     Decimal          @default(0) @map("total_refunds") @db.Decimal(14, 2)
  netPayout        Decimal          @map("net_payout") @db.Decimal(14, 2)
  status           SettlementStatus @default(DRAFT)
  approvedByUserId String?          @map("approved_by_user_id") @db.Uuid
  paidAt           DateTime?        @map("paid_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  approvedByUser User?            @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items          SettlementItem[]

  @@index([sellerId, status])
  @@map("settlements")
}

model SettlementItem {
  id                 String   @id @default(uuid()) @db.Uuid
  settlementId       String   @map("settlement_id") @db.Uuid
  commissionLedgerId String   @unique @map("commission_ledger_id") @db.Uuid
  amount             Decimal  @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  settlement       Settlement       @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  commissionLedger CommissionLedger @relation(fields: [commissionLedgerId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("settlement_items")
}

